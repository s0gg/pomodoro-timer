{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "private": true,
  "description": "A Pomodoro timer that runs in the browser (one set: 25 → 5 → 25 → 5 → 25 → 15 min)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs --build --fast",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ast": "ast-grep scan && ast-grep test --skip-snapshot-tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:ast && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
